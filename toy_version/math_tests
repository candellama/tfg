class TestWrongKey(unittest.TestCase):
    def setUp(self):
        self.msg = b""
def create_wrong_key_test_for_level(level):
    def test_verify_with_wrong_public_key(self):
        """Test that a signature fails verification if checked against a different public key"""
        ml_dsa_1 = MLDSA(security_level=level)
        ml_dsa_2 = MLDSA(security_level=level)
        
        _ , sk = ml_dsa_1.generate_keypair()
        pk_wrong, _ = ml_dsa_2.generate_keypair()
        
        msg = b"Message from Alice"
        
        try:
            # sign the message with the correct private key
            signature = ml_dsa_1.sign(msg, sk)
            
            # try to verify it using the wrong public key
            is_valid = ml_dsa_2.verify(msg, signature, pk_wrong)
            
            self.assertFalse(is_valid, "Critical: Verification passed with the wrong public key")
        except RuntimeError as e:
            self.fail(f"Failed to sign due to attempt limit: {e}")
    return test_verify_with_wrong_public_key

for lvl in [2, 3, 5]:
    setattr(TestWrongKey, f"test_wrong_key_level_{lvl}", create_wrong_key_test_for_level(lvl))  

