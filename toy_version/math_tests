class TestPerformance(unittest.TestCase):
    def setUp(self):
        self.msg = b"Hello, world!"

    def _benchmark_level(self, level: int, repetitions: int = 1):
        # lists to store execution times 
        keygen_times = []
        sign_times = []
        verify_times = []
        
        # Counters for failures
        sign_failures = 0
        verify_failures = 0

        # List to store number of attepts for successful signings
        sign_attempts_list = []

        for _ in range(repetitions):
            ml_dsa = MLDSA(security_level=level)

            # 1. Key generation 
            t0 = time.perf_counter()
            public_key, private_key = ml_dsa.generate_keypair()
            t1 = time.perf_counter()
            keygen_times.append((t1 - t0)* 1000)

            # 2. Signing 
            t0 = time.perf_counter()
            # try except to count failures in signing without stopping the test
            try:
                signature = ml_dsa.sign(self.msg, private_key)
                t1 = time.perf_counter()
                sign_times.append((t1 - t0)* 1000)
                
                # append number of attempts taken for successful sign
                attempts_taken = signature[2] + 1
                sign_attempts_list.append(attempts_taken)
                
            except RuntimeError:
                # if signing fails (>10000 attempts), count the failure and continue with next signing
                sign_failures += 1
                continue 

            # 3. Verification 
            t0 = time.perf_counter()
            is_valid = ml_dsa.verify(self.msg, signature, public_key)
            t1 = time.perf_counter()
            verify_times.append((t1 - t0)* 1000)

            # count verification failures
            if not is_valid:
                verify_failures += 1

        return {
            "level": level,
            "keygen_avg": mean(keygen_times) if keygen_times else 0,
            "sign_avg": mean(sign_times) if sign_times else 0,
            "verify_avg": mean(verify_times) if verify_times else 0,
            "sign_failures": sign_failures,
            "verify_failures": verify_failures,
            "sign_attempts_avg": mean(sign_attempts_list) if sign_attempts_list else 0,
        }

    def test_performance_by_security_level(self):
        repetitions = 5
        results = []

        for level in [2, 3, 5]:
            result = self._benchmark_level(level, repetitions=repetitions)
            results.append(result)

        print(f"\nAverage execution times and stats over {repetitions} runs")
        print("-" * 105)
        print(f"{'Level':<8}{'KeyGen (ms)':<15}{'Sign (ms)':<15}{'Verify (ms)':<15}{'Sign Fails':<15}{'Verif Fails':<15}{'Avg Attempts':<15}")
        print("-" * 105)

        for r in results:
            print(
                f"{r['level']:<8}"
                f"{r['keygen_avg']:<15.3f}"
                f"{r['sign_avg']:<15.3f}"
                f"{r['verify_avg']:<15.3f}"
                f"{r['sign_failures']:<15}"
                f"{r['verify_failures']:<15}"
                f"{r['sign_attempts_avg']:<15.2f}"
            )






